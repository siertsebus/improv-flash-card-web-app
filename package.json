{
  "name": "improv-flashcards",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply improv-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply improv-db --remote",
    "deploy": "vite build && wrangler d1 migrations apply improv-db --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.14",
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@preact/preset-vite": "^2.10.6",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
